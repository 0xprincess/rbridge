# The control port is reachable only through the authenticated SSH relay.
bindAddr = "127.0.0.1"
bindPort = {{ frp_server_port | int }}
proxyBindAddr = "127.0.0.1"
# An empty allowPorts list means unrestricted in FRP. With no publications,
# permit only the already-bound control port, which cannot become a proxy.
allowPorts = [{% for service in frp_services_normalized %}{ single = {{ service.relay_port }} }{{ ", " if not loop.last else "" }}{% else %}{ single = {{ frp_server_port | int }} }{% endfor %}]
maxPortsPerClient = {{ [frp_services_normalized | length, 1] | max }}
auth.method = "token"
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]
auth.tokenSource.type = "file"
auth.tokenSource.file.path = "/etc/rbridge/token"
transport.tcpMux = false
log.to = "console"
log.level = "info"
log.disablePrintColor = true
webServer.addr = "127.0.0.1"
webServer.port = {{ frp_server_admin_port }}
webServer.user = {{ frp_admin_user | to_json }}
webServer.password = {{ frp_admin_password | to_json }}

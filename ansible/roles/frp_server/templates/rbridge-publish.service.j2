# Managed by rbridge; socket activation preserves native application bytes.
[Unit]
Description=TCP forwarding for {{ item.name }}
BindsTo=rbridge-publish-{{ item.name }}.socket
After=rbridge-publish-{{ item.name }}.socket rbridge-server.service
Wants=rbridge-server.service
StartLimitIntervalSec=0

[Service]
# Under SELinux, starting via env (bin_t) runs the proxy as unconfined_service_t
# like the other rbridge services: NoNewPrivileges= forbids the transition into
# systemd_socket_proxyd_t, whose policy also cannot reach unlabeled FRP ports.
ExecStart=/usr/bin/env /usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:{{ item.relay_port }}
User={{ frp_service_user }}
Group={{ frp_service_user }}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

# Managed by rbridge; socket activation preserves native application bytes.
[Unit]
Description=TCP forwarding for {{ item.name }}
BindsTo=rbridge-publish-{{ item.name }}.socket
After=rbridge-publish-{{ item.name }}.socket rbridge-server.service
Wants=rbridge-server.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:{{ item.relay_port }}
User={{ frp_service_user }}
Group={{ frp_service_user }}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Unit]
Description=rbridge HTTPS publishing (dedicated Caddy)
Wants=network-online.target
After=network-online.target rbridge-server.service

[Service]
Type=notify
User=rbridge-web
Group=rbridge-web
Environment=HOME=/var/lib/rbridge-web
Environment=XDG_DATA_HOME=/var/lib/rbridge-web/data
Environment=XDG_CONFIG_HOME=/var/lib/rbridge-web/config
RuntimeDirectory=rbridge-web
RuntimeDirectoryMode=0700
ExecStartPre={{ frp_web_caddy_binary }} validate --config /etc/rbridge/web/Caddyfile --adapter caddyfile
ExecStart={{ frp_web_caddy_binary }} run --config /etc/rbridge/web/Caddyfile --adapter caddyfile
ExecReload={{ frp_web_caddy_binary }} validate --config /etc/rbridge/web/Caddyfile --adapter caddyfile
ExecReload={{ frp_web_caddy_binary }} reload --config /etc/rbridge/web/Caddyfile --adapter caddyfile --address unix//run/rbridge-web/admin.sock
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=1048576
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rbridge-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Key-only SSH backend for FRP
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=sshd frp-tunnel-sshd
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/sshd -t -f /etc/frp-tunnel/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/frp-tunnel/sshd_config
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

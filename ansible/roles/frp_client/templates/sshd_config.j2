# Dedicated instance: does not edit the system-wide sshd configuration.
Port {{ frp_backend_ssh_port | int }}
ListenAddress 127.0.0.1
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile /run/rbridge-sshd/sshd.pid
AuthorizedKeysFile /etc/rbridge/login_authorized_keys
AllowUsers {{ frp_login_user }}
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
HostbasedAuthentication no
GSSAPIAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
StrictModes yes
UsePAM yes
X11Forwarding no
PrintMotd no
Subsystem sftp /usr/lib/openssh/sftp-server

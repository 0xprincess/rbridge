[Unit]
Description=Key-only SSH backend for FRP
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=rbridge-sshd
RuntimeDirectoryMode=0755
# The shared OpenSSH directory must not be removed when this instance stops.
ExecStartPre=/usr/bin/install -d -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/rbridge/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/rbridge/sshd_config
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

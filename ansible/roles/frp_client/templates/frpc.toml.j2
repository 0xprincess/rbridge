# The SSH transport encrypts and authenticates the complete control/data stream.
serverAddr = "127.0.0.1"
serverPort = {{ frp_forward_port | int }}
loginFailExit = false
auth.method = "token"
auth.additionalScopes = ["HeartBeats", "NewWorkConns"]
auth.tokenSource.type = "file"
auth.tokenSource.file.path = "/etc/rbridge/token"
transport.protocol = "tcp"
transport.proxyURL = ""
transport.tcpMux = false
transport.tls.enable = false
log.to = "console"
log.level = "info"
log.disablePrintColor = true
webServer.addr = "127.0.0.1"
webServer.port = {{ frp_client_admin_port }}
webServer.user = {{ frp_admin_user | to_json }}
webServer.password = {{ frp_admin_password | to_json }}

{% for service in frp_services_normalized %}
[[proxies]]
name = {{ service.name | to_json }}
type = "tcp"
localIP = {{ service.backend_host | to_json }}
localPort = {{ service.backend_port }}
remotePort = {{ service.relay_port }}
transport.useEncryption = true
{% endfor %}

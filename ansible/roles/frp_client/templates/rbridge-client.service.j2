[Unit]
Description=rbridge client
Wants=network-online.target{{ ' rbridge-sshd.service' if frp_managed_ssh else '' }}
After=network-online.target rbridge-transport.service{{ ' rbridge-sshd.service' if frp_managed_ssh else '' }}
Requires=rbridge-transport.service
PartOf=rbridge-transport.service
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ frp_service_user }}
Group={{ frp_service_user }}
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStartPre={{ frp_binary_dir }}/frpc verify -c /etc/rbridge/frpc.toml
ExecStart={{ frp_binary_dir }}/frpc -c /etc/rbridge/frpc.toml
Restart=always
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
